# ---------------------------------------------------------------------------
# MODA BARBER CLUB — environment
#
# Leave these empty to run the site in DEMO MODE: bookings are stored in the
# visitor's own browser (localStorage). Fill them in to switch the exact same
# UI over to Supabase — no component changes required.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe for the browser: it is protected by the
# Row Level Security policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role key in a NEXT_PUBLIC_* variable and never commit
# it. It bypasses Row Level Security. Server-side use only.
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
